---
import { altLocalePath, resolveLocale, useT } from '../i18n/ui';

const locale = resolveLocale(Astro.currentLocale);
const t = useT(locale);

const navItems = [
  { href: '#experiencia', label: t('nav.experience') },
  { href: '#sistemas', label: t('nav.systems') },
  { href: '#proyectos', label: t('nav.projects') },
  { href: '#stack', label: t('nav.stack') },
  { href: '#contacto', label: t('nav.contact') },
];
---

<header class="site-header">
  <div class="progress" aria-hidden="true">
    <div class="progress-bar" id="scroll-progress"></div>
  </div>

  <div class="container header-inner">
    <a href="#top" class="brand" aria-label={t('nav.backToTop')}
      >BC<span aria-hidden="true">.</span></a
    >

    <nav aria-label={t('nav.aria')}>
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="controls">
      <a
        class="lang-switch"
        href={altLocalePath(locale)}
        aria-label={t('lang.switch')}
      >
        {t('lang.label')}
      </a>

      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label={t('theme.toggle')}
        aria-pressed="false"
      >
        <svg
          class="icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          ></path>
        </svg>
        <svg
          class="icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .progress {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: transparent;
  }

  .progress-bar {
    height: 100%;
    width: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand span {
    color: var(--ink-muted);
  }

  .nav-list {
    display: flex;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    list-style: none;
    padding: 0;
  }

  .nav-link {
    position: relative;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.25s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s var(--ease-out);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .lang-switch {
    display: grid;
    place-items: center;
    height: 2.4rem;
    padding-inline: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.25s ease, background-color 0.25s ease,
      color 0.25s ease;
  }

  .lang-switch:hover {
    border-color: var(--line-strong);
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elevated);
    cursor: pointer;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .theme-toggle:hover {
    border-color: var(--line-strong);
    transform: rotate(15deg);
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme='dark']) .icon-moon {
    display: block;
  }

  :global([data-theme='dark']) .icon-sun {
    display: none;
  }

  @media (max-width: 640px) {
    .nav-list {
      gap: 0.9rem;
    }

    .nav-link {
      font-size: 0.82rem;
    }
  }

  /* Narrow phones: nav drops to its own row instead of overflowing */
  @media (max-width: 560px) {
    .header-inner {
      flex-wrap: wrap;
      height: auto;
      padding-block: 0.65rem;
      row-gap: 0.35rem;
    }

    nav {
      order: 3;
      width: 100%;
    }

    .nav-list {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>

<script is:inline>
  // Runs during parse, right after the button exists: sets the initial
  // pressed state before first paint. The module script below keeps it
  // in sync on every toggle.
  document
    .getElementById('theme-toggle')
    ?.setAttribute(
      'aria-pressed',
      String(document.documentElement.dataset.theme === 'dark')
    );
</script>

<script>
  const toggle = document.getElementById('theme-toggle');

  const syncPressedState = () => {
    const isDark = document.documentElement.dataset.theme === 'dark';
    toggle?.setAttribute('aria-pressed', String(isDark));
  };

  toggle?.addEventListener('click', () => {
    const next =
      document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage unavailable (private mode); theme still applies for the session.
    }
    syncPressedState();
  });

  // Scroll progress bar, throttled to animation frames.
  const bar = document.getElementById('scroll-progress');
  let ticking = false;

  const updateProgress = () => {
    const max =
      document.documentElement.scrollHeight - window.innerHeight;
    const fraction = max > 0 ? window.scrollY / max : 0;
    bar?.style.setProperty('transform', `scaleX(${fraction})`);
    ticking = false;
  };

  updateProgress();
  document.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateProgress);
      }
    },
    { passive: true }
  );
</script>
