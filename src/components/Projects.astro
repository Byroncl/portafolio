---
import { projects } from '../data/cv';
import SectionHeading from './SectionHeading.astro';
import { resolveLocale, useT } from '../i18n/ui';

const locale = resolveLocale(Astro.currentLocale);
const t = useT(locale);
---

<section id="proyectos" class="section" aria-labelledby="proyectos-title">
  <div class="container">
    <SectionHeading
      index="04"
      title={t('section.projects')}
      id="proyectos-title"
    />

    <div class="grid">
      {
        projects.map((project, index) => (
          <article class="card reveal" style={`--reveal-delay: ${index * 0.1}s`}>
            <h3>{project.name}</h3>
            <p>{project.description[locale]}</p>
            <ul class="tags" aria-label={`${t('projects.techAria')} ${project.name}`}>
              {project.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 12px;
    transition: transform 0.3s var(--ease-out), border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }

  h3 {
    font-size: 1.25rem;
  }

  .card p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
