---
import { experience } from '../data/cv';
import SectionHeading from './SectionHeading.astro';
import { resolveLocale, useT } from '../i18n/ui';

const locale = resolveLocale(Astro.currentLocale);
const t = useT(locale);
const entries = experience[locale];
---

<section id="experiencia" class="section" aria-labelledby="experiencia-title">
  <div class="container">
    <SectionHeading
      index="01"
      title={t('section.experience')}
      id="experiencia-title"
    />

    <ol class="timeline">
      {
        entries.map((job, jobIndex) => (
          <li class="job reveal" style={`--reveal-delay: ${jobIndex * 0.08}s`}>
            <div class="job-header">
              <div>
                <h3>{job.role}</h3>
                <p class="company">{job.company}</p>
              </div>
              <p class="period">
                {job.period}
                {job.current && (
                  <span class="badge">{t('experience.current')}</span>
                )}
              </p>
            </div>

            <ul class="highlights">
              {job.highlights.map((item) => (
                <li>
                  <strong>{item.title}.</strong> {item.description}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .job {
    position: relative;
    padding-left: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 1px solid var(--line);
  }

  .job::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.5rem;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--bg);
    border: 2px solid var(--ink);
  }

  .job-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  h3 {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    margin-bottom: 0.25rem;
  }

  .company {
    font-weight: 500;
    color: var(--ink-soft);
  }

  .period {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .badge {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .highlights {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    max-width: 52rem;
  }

  .highlights li {
    color: var(--ink-soft);
    font-size: 0.96rem;
    padding-left: 1.1rem;
    position: relative;
  }

  .highlights li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--ink-muted);
  }

  .highlights strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
